# Ingestion service
SERVER_PORT=8098
JWT_SECRET=change-me-in-production-use-at-least-256-bits-secret-key!!

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_REPLICATION_FACTOR=1

# PostgreSQL / TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=drep
POSTGRES_USER=drep
POSTGRES_PASSWORD=drep

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# Stream processor
STREAM_PROCESSOR_PORT=8099

# Dashboard service
DASHBOARD_SERVICE_PORT=8101
DASHBOARD_SERVICE_URL=http://localhost:8101
INGESTION_SERVICE_URL=http://localhost:8098
STREAM_PROCESSOR_URL=http://localhost:8099
ANALYTICS_SERVICE_URL=http://localhost:8100

ADMIN_API_KEY=admin-key

# Producer SDK (optional — for apps using the Java client)
DREP_INGESTION_URL=http://localhost:8098
DREP_API_KEY=tenant-a-key
